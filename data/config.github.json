    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": false,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": false,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "keywords": [],
      "fetch_limit": 10,
      "profile": "tech-news"
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All"
      ],
      "keywords": [],
      "min_stars": 10,
      "max_items": 30,
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": false,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": false,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    },
    "gdelt": {
      "enabled": false,
      "query": "social policy reform",
      "mode": "ArtList",
      "max_records": 75,
      "category": "world-news",
      "profile": "world-policy"
    },
    "google_news": {
      "enabled": false,
      "query": "social policy",
      "language": "en",
      "country": "US",
      "max_results": 50,
      "category": "world-news",
      "profile": "world-policy"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "world-policy",
      "finance-news",
      "tech-news",
      "tech-blog"
    ],
    "category_groups": {
      "policy": {
        "name": "国际 / 政治 / 社会政策",
        "limit": 7,
        "categories": [
          "world-news",
          "us-politics",
          "uk-politics",
          "geopolitics",
          "society",
          "russia-ukraine",
          "cn-world"
        ]
      },
      "finance": {
        "name": "财经",
        "limit": 7,
        "categories": [
          "finance",
          "cn-finance",
          "equities"
        ]
      },
      "tech": {
        "name": "科技",
        "limit": 4,
        "categories": [
          "tech-general",
          "ai-tools",
          "github-trending",
          "semiconductors",
          "llm-inference",
          "software-engineering"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "text": "#{message_title}\n#{summary}"
    },
    "headers": ""
  },
  "wechat": {
    "enabled": false,
    "languages": null,
    "chunk_size": 4000
  }
}
